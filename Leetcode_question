class Solution {
public:
    long long countCommas(long long n) {
        if (n < 1000) return 0;

        long long ans = 0;
        long long start = 1000;
        long long commas = 1;

        while (start <= n) {
            long long end = min(n, start * 1000 - 1);

            ans += (end - start + 1) * commas;

            start *= 1000;
            commas++;
        }

        return ans;
    }

    long long countCommasInRange(long long n, long long m) {
        return countCommas(m) - countCommas(n - 1);
    }
};
